<?xml version="1.0" encoding="utf-8"?>
<!--
  ScreenGrabCraft MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus its UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2` and the same for WixToolset.Util.wixext).
  Built by package.ps1:

    wix build screengrabcraft.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=1.2.3 -d BinDir=... -d IconPath=... -d EditorIconPath=... -d LicenseRtf=... -o out.msi

  The capture service (screengrabcraft.exe), the editor (screengrabcraft-editor.exe) and the
  command-line program (screengrabcraft-cli.exe), with Start Menu shortcuts for the first two. The
  capture service starts at every sign-in (the Run value below). The installer shows the standard
  WiX look: the license with the choice of who it's for, progress, and a finish page.

  One package, two ways to install it (a "dual-purpose" package, Windows Installer 5.0):
  - for everyone on this PC (per-machine): Program Files\ScreenGrabCraft, the all-users Start
    menu, HKLM. An administrator has to allow it (UAC). This is the default, as it always was:
    `msiexec /i x.msi`, `/passive` and `/qn` all install per-machine.
  - just for me (per-user): %LocalAppData%\Programs\ScreenGrabCraft, my own Start menu, HKCU. No
    administrator. The installer's first page offers it; on the command line it is
    `msiexec /i x.msi ALLUSERS=2 MSIINSTALLPERUSER=1` (both: the package's own ALLUSERS is 1, and
    Windows reads MSIINSTALLPERUSER only when ALLUSERS is 2).
  Everything below works in both: the files go under ProgramFiles6432Folder, which Windows points
  at %LocalAppData%\Programs for a per-user install, and every registry value is HKMU, which is
  HKLM per-machine and HKCU per-user. Nothing needs an administrator except the location.
  An install keeps its scope: Windows upgrades only a product installed the same way, so the
  first page offers only the earlier install's scope when there is one, a silent install in the
  other scope stops with a message, and the capture service's own updater passes the
  properties of the scope it was installed in.

  UpgradeCode and the component GUIDs below belong to ScreenGrabCraft alone. Never copy them from
  (or into) a sibling Craft app: Windows Installer treats every package sharing an UpgradeCode as
  one product, so a shared code makes one app's installer refuse to install ("a newer version is
  already installed") or silently uninstall the other. packaging-lint.yml checks this file has no
  GUID twice.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
    xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
    xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
      Name="ScreenGrabCraft"
      Manufacturer="ScreenGrabCraft contributors"
      Version="$(var.Version)"
      UpgradeCode="D251D9E0-8740-4BEF-B722-8D5913A73A25"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="ScreenGrabCraft screen capture and annotation" Manufacturer="ScreenGrabCraft contributors" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of ScreenGrabCraft is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="ScreenGrabCraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Icon Id="ScreenGrabCraftEditorIcon.ico" SourceFile="$(var.EditorIconPath)" />
    <Property Id="ARPPRODUCTICON" Value="ScreenGrabCraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/billsecond/screengrabcraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/billsecond/screengrabcraft" />
    <Property Id="ARPHELPLINK" Value="https://github.com/billsecond/screengrabcraft/issues" />

    <!-- The capture service runs all the time (tray icon, Print Screen and the other capture
         shortcuts): screengrabcraft.exe started with its background flag (the Run value below;
         XML comments can't spell the flag's double hyphen) is a small supervisor that runs the
         tray process and restarts it if it exits abnormally. An upgrade or an uninstall must close it,
         or its files stay in use and Windows asks for a reboot. WixCloseApplications (Util
         extension, before InstallValidate) sends WM_CLOSE to the windows of every
         screengrabcraft.exe, on which the tray process quits as with its Quit command; whatever
         is still running after the timeout (the windowless supervisor) is terminated, with exit
         code 0 so a supervisor that is still there sees a normal end and doesn't restart the
         tray. Never a reboot prompt. Only when the program is already installed (repair,
         uninstall) or an older version is being replaced: a first install leaves a portable copy
         alone.
         The Util extension sequences this before InstallFiles, which on an uninstall comes after
         RemoveFiles: the terminating half (a deferred action) would then run after the files it
         holds were due to go, and the uninstall would need a reboot. It is moved to the start of
         the install script instead, ahead of every removal. (It can't go before InstallInitialize:
         it schedules a deferred action.) -->
    <util:CloseApplication Id="CloseScreenGrabCraft" Target="screengrabcraft.exe"
        CloseMessage="yes" TerminateProcess="0" RebootPrompt="no"
        Condition="Installed OR WIX_UPGRADE_DETECTED" />
    <InstallExecuteSequence>
      <Custom Action="override Wix4CloseApplications_$(sys.BUILDARCHSHORT)" After="InstallInitialize"
          Condition="VersionNT &gt; 400" />
    </InstallExecuteSequence>

    <!-- An earlier ScreenGrabCraft, and how it was installed: the capture service's App Paths
         entry, in HKLM for everyone on this PC, in HKCU for this person alone. (The registry view
         is the package's own, so an x64 package reads the 64-bit HKLM, where its earlier
         versions wrote.) -->
    <Property Id="SGC_MACHINE_INSTALL" Secure="yes">
      <RegistrySearch Id="EarlierMachineInstall" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\screengrabcraft.exe" Type="raw" />
    </Property>
    <Property Id="SGC_USER_INSTALL" Secure="yes">
      <RegistrySearch Id="EarlierUserInstall" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\screengrabcraft.exe" Type="raw" />
    </Property>

    <!-- An install in the other scope than the earlier one would not replace it (Windows upgrades
         only a product installed the same way) but sit beside it, with a second sign-in entry. A
         silent install that would do that stops instead. The context is per-user when ALLUSERS
         is empty, or still 2 with MSIINSTALLPERUSER set (Windows resets ALLUSERS=2 to 1 or empty
         as it decides). -->
    <CustomAction Id="InstalledForEveryone" Error="ScreenGrabCraft is installed for everyone on this PC, so this version can only be installed for everyone too (leave out ALLUSERS=2 MSIINSTALLPERUSER=1). To have it just for you, uninstall it first." />
    <CustomAction Id="InstalledJustForYou" Error="ScreenGrabCraft is installed just for you, so this version can only be installed just for you too (msiexec /i with ALLUSERS=2 MSIINSTALLPERUSER=1). To have it for everyone on this PC, uninstall it first." />
    <InstallExecuteSequence>
      <Custom Action="InstalledForEveryone" After="AppSearch"
          Condition="NOT Installed AND SGC_MACHINE_INSTALL AND (NOT ALLUSERS OR (ALLUSERS = 2 AND MSIINSTALLPERUSER = 1))" />
      <Custom Action="InstalledJustForYou" After="InstalledForEveryone"
          Condition="NOT Installed AND SGC_USER_INSTALL AND NOT SGC_MACHINE_INSTALL AND NOT (NOT ALLUSERS OR (ALLUSERS = 2 AND MSIINSTALLPERUSER = 1))" />
    </InstallExecuteSequence>

    <!-- With the full UI, Windows looks for the version to replace (FindRelatedProducts) in the UI
         process, once, in the context it starts in: per-machine, the package's default. When the
         earlier install is per-user (and there is no per-machine one, which then wins), that
         context is switched to per-user first, so the earlier version is found and replaced; the
         first page then offers only "Just for me". AppSearch runs first to know. (ALLUSERS is
         emptied through a property that is never set: an empty ALLUSERS is per-user.) -->
    <CustomAction Id="LookForTheEarlierUserInstall" Property="ALLUSERS" Value="[SGC_NO_VALUE]" Execute="immediate" />
    <InstallUISequence>
      <AppSearch Sequence="22" />
      <Custom Action="LookForTheEarlierUserInstall" Sequence="23"
          Condition="NOT Installed AND SGC_USER_INSTALL AND NOT SGC_MACHINE_INSTALL" />
    </InstallUISequence>

    <!-- Installer UI: WixUI_Minimal (progress, the finish page, repair and remove), with its first
         page (the license, whose Install button installs) replaced by the same page with two
         buttons, "Just for me" and "Everyone on this PC", which also decide the scope. Its
         dialogs and bitmaps are WiX's own (WixToolset.UI.wixext); package.ps1 builds the license
         RTF from LICENSE-MIT, LICENSE-APACHE and the fonts' OFL.
         "Just for me" sets ALLUSERS=2 and MSIINSTALLPERUSER=1 (as Microsoft's dual-purpose sample
         does) and points INSTALLFOLDER at %LocalAppData%\Programs\ScreenGrabCraft, where Windows
         puts a per-user install's ProgramFiles6432Folder: the UI process resolved its folders
         per-machine, and its INSTALLFOLDER is the one handed to the install and the one the finish
         page launches from. "Everyone on this PC" (with the administrator shield) sets ALLUSERS=1.
         When an earlier version is installed, only its scope's button is enabled.
         The finish page offers to start the capture service (ticked by default) the way a sign-in
         does (the same command line as the Run value), from the installer's UI process (as the
         person installing, not from the elevated install service), without waiting for it; silent
         installs (/qn) never show it, and the service then starts at the next sign-in. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch ScreenGrabCraft" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchScreenGrabCraft" FileRef="ScreenGrabCraftExe" ExeCommand="--background"
        Return="asyncNoWait" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchScreenGrabCraft"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />

      <Dialog Id="ScopeEulaDlg" Width="370" Height="270" Title="!(loc.WelcomeEulaDlg_Title)">
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="!(loc.WelcomeEulaDlgBitmap)" />
        <Control Id="Title" Type="Text" X="130" Y="6" Width="225" Height="30" Transparent="yes" NoPrefix="yes" Text="!(loc.WelcomeEulaDlgTitle)" />
        <Control Id="LicenseText" Type="ScrollableText" X="130" Y="36" Width="226" Height="124" Sunken="yes" TabSkip="no">
          <Text SourceFile="!(wix.WixUILicenseRtf)" />
        </Control>
        <Control Id="LicenseAcceptedCheckBox" Type="CheckBox" X="130" Y="164" Width="226" Height="18" CheckBoxValue="1" Property="SgcLicenseAccepted" Text="!(loc.WelcomeEulaDlgLicenseAcceptedCheckBox)" />
        <Control Id="ChoiceText" Type="Text" X="130" Y="188" Width="226" Height="40" Transparent="yes" NoPrefix="yes" Hidden="yes"
            ShowCondition="NOT SGC_MACHINE_INSTALL AND NOT SGC_USER_INSTALL"
            Text="Who is it for? Just for you needs no administrator and installs in your own folders. Everyone on this PC needs an administrator's permission." />
        <Control Id="MachineText" Type="Text" X="130" Y="188" Width="226" Height="40" Transparent="yes" NoPrefix="yes" Hidden="yes"
            ShowCondition="SGC_MACHINE_INSTALL"
            Text="ScreenGrabCraft is installed for everyone on this PC, so this version replaces it there. Windows asks for an administrator's permission." />
        <Control Id="UserText" Type="Text" X="130" Y="188" Width="226" Height="40" Transparent="yes" NoPrefix="yes" Hidden="yes"
            ShowCondition="SGC_USER_INSTALL AND NOT SGC_MACHINE_INSTALL"
            Text="ScreenGrabCraft is installed just for you, so this version replaces it there. No administrator is needed." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="JustForMe" Type="PushButton" X="114" Y="243" Width="76" Height="17" Text="Just for &amp;me"
            DisableCondition="SgcLicenseAccepted &lt;&gt; &quot;1&quot; OR SGC_MACHINE_INSTALL"
            EnableCondition="SgcLicenseAccepted = &quot;1&quot; AND NOT SGC_MACHINE_INSTALL">
          <Publish Property="ALLUSERS" Value="2" Order="1" />
          <Publish Property="MSIINSTALLPERUSER" Value="1" Order="2" />
          <Publish Property="INSTALLFOLDER" Value="[LocalAppDataFolder]Programs\ScreenGrabCraft\" Order="3" />
          <Publish Event="SetTargetPath" Value="INSTALLFOLDER" Order="4" />
          <Publish Event="SpawnWaitDialog" Value="WaitForCostingDlg" Order="5" Condition="!(wix.WixUICostingPopupOptOut) OR CostingComplete = 1" />
          <Publish Event="EndDialog" Value="Return" Order="6" Condition="OutOfDiskSpace &lt;&gt; 1" />
          <Publish Event="SpawnDialog" Value="OutOfRbDiskDlg" Order="7" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND (PROMPTROLLBACKCOST=&quot;P&quot; OR NOT PROMPTROLLBACKCOST)" />
          <Publish Event="EndDialog" Value="Return" Order="8" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST=&quot;D&quot;" />
          <Publish Event="EnableRollback" Value="False" Order="9" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST=&quot;D&quot;" />
          <Publish Event="SpawnDialog" Value="OutOfDiskDlg" Order="10" Condition="(OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 1) OR (OutOfDiskSpace = 1 AND PROMPTROLLBACKCOST=&quot;F&quot;)" />
        </Control>
        <Control Id="Everyone" Type="PushButton" ElevationShield="yes" X="196" Y="243" Width="102" Height="17" Default="yes" Text="&amp;Everyone on this PC"
            DisableCondition="SgcLicenseAccepted &lt;&gt; &quot;1&quot; OR (SGC_USER_INSTALL AND NOT SGC_MACHINE_INSTALL)"
            EnableCondition="SgcLicenseAccepted = &quot;1&quot; AND (SGC_MACHINE_INSTALL OR NOT SGC_USER_INSTALL)">
          <Publish Property="ALLUSERS" Value="1" Order="1" />
          <Publish Event="SpawnWaitDialog" Value="WaitForCostingDlg" Order="2" Condition="!(wix.WixUICostingPopupOptOut) OR CostingComplete = 1" />
          <Publish Event="EndDialog" Value="Return" Order="3" Condition="OutOfDiskSpace &lt;&gt; 1" />
          <Publish Event="SpawnDialog" Value="OutOfRbDiskDlg" Order="4" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND (PROMPTROLLBACKCOST=&quot;P&quot; OR NOT PROMPTROLLBACKCOST)" />
          <Publish Event="EndDialog" Value="Return" Order="5" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST=&quot;D&quot;" />
          <Publish Event="EnableRollback" Value="False" Order="6" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST=&quot;D&quot;" />
          <Publish Event="SpawnDialog" Value="OutOfDiskDlg" Order="7" Condition="(OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 1) OR (OutOfDiskSpace = 1 AND PROMPTROLLBACKCOST=&quot;F&quot;)" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>
    <InstallUISequence>
      <Show Dialog="override WelcomeEulaDlg" Before="ProgressDlg" Condition="0" />
      <Show Dialog="ScopeEulaDlg" Before="ProgressDlg" Condition="NOT Installed" />
    </InstallUISequence>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="ScreenGrabCraft">
        <Directory Id="MODELSFOLDER" Name="models" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="ScreenGrabCraft" Level="1">
      <ComponentGroupRef Id="ScreenGrabCraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="ScreenGrabCraftFiles" Directory="INSTALLFOLDER">
      <!-- The capture service. Its shortcut starts it, or brings the running one's window
           forward. -->
      <Component Id="ScreenGrabCraftApp" Guid="DA075F78-50E8-4549-AD50-85A8FF21FA73">
        <File Id="ScreenGrabCraftExe" Source="$(var.BinDir)\screengrabcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="ScreenGrabCraft"
              Description="Capture the screen, a window or a region" WorkingDirectory="INSTALLFOLDER"
              Advertise="yes" Icon="ScreenGrabCraftIcon.ico" IconIndex="0" />
        </File>
        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\screengrabcraft.exe" Value="[#ScreenGrabCraftExe]" Type="string" />
      </Component>

      <!-- Started at every sign-in: the persistent per-user service. For every user from HKLM
           (per-machine), for the one who installed it from HKCU (per-user). Each person can turn
           it off in the app's settings or in Task Manager › Startup apps (Windows keeps that
           choice per user, under StartupApproved); nothing here changes when they do, and the
           app never deletes this value (it is the component's key path: a missing one would make
           Windows repair it back). Removed on uninstall. -->
      <Component Id="StartAtSignIn" Guid="5C9658CB-9D98-4682-9428-F655BB59A5F3">
        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="ScreenGrabCraft"
            Value="&quot;[INSTALLFOLDER]screengrabcraft.exe&quot; --background" Type="string" KeyPath="yes" />
      </Component>

      <!-- The editor. -->
      <Component Id="EditorApp" Guid="3A266682-07F5-4C1D-9625-0A0D11CFF9A0">
        <File Id="EditorExe" Source="$(var.BinDir)\screengrabcraft-editor.exe" KeyPath="yes">
          <Shortcut Id="EditorStartMenuShortcut" Directory="ProgramMenuFolder" Name="ScreenGrabCraft Editor"
              Description="Mark up screenshots and pictures" WorkingDirectory="INSTALLFOLDER"
              Advertise="yes" Icon="ScreenGrabCraftEditorIcon.ico" IconIndex="0" />
        </File>
        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\screengrabcraft-editor.exe" Value="[#EditorExe]" Type="string" />
      </Component>

      <!-- What the editor opens. Each picture type gets a ScreenGrabCraft ProgId (name, icon, open
           command) listed under the extension's OpenWithProgids, so the editor shows in
           Explorer's "Open with", and is one of the editor's Capabilities (RegisteredApplications),
           so the owner can pick it in Settings › Default apps. Nothing here sets a default for a
           type another program owns: the installer never takes .png, .jpg, .jpeg, .gif, .bmp or
           .webp over. A project file (.sgcraft, JSON) is ScreenGrabCraft's own and opens in the
           editor. Removed again on uninstall. -->
      <Component Id="EditorFileTypes" Guid="29FA50D6-B7E9-447B-B667-8020A6AFE666">
        <RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="ScreenGrabCraft Editor" Value="Software\ScreenGrabCraft\Editor\Capabilities" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKMU" Key="Software\ScreenGrabCraft\Editor\Capabilities" Name="ApplicationName" Value="ScreenGrabCraft Editor" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\ScreenGrabCraft\Editor\Capabilities" Name="ApplicationDescription" Value="Marks up screenshots and pictures: arrows, callouts, highlights, blur and text." Type="string" />
        <RegistryValue Root="HKMU" Key="Software\ScreenGrabCraft\Editor\Capabilities" Name="ApplicationIcon" Value="&quot;[#EditorExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\screengrabcraft-editor.exe" Name="FriendlyAppName" Value="ScreenGrabCraft Editor" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\screengrabcraft-editor.exe\shell\open\command" Value="&quot;[#EditorExe]&quot; &quot;%1&quot;" Type="string" />

        <ProgId Id="ScreenGrabCraft.Png" Description="PNG Image" Icon="EditorExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\ScreenGrabCraft.Png\shell\open\command" Value="&quot;[#EditorExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.png\OpenWithProgids" Name="ScreenGrabCraft.Png" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\screengrabcraft-editor.exe\SupportedTypes" Name=".png" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\ScreenGrabCraft\Editor\Capabilities\FileAssociations" Name=".png" Value="ScreenGrabCraft.Png" Type="string" />

        <ProgId Id="ScreenGrabCraft.Jpeg" Description="JPEG Image" Icon="EditorExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\ScreenGrabCraft.Jpeg\shell\open\command" Value="&quot;[#EditorExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpg\OpenWithProgids" Name="ScreenGrabCraft.Jpeg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpeg\OpenWithProgids" Name="ScreenGrabCraft.Jpeg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\screengrabcraft-editor.exe\SupportedTypes" Name=".jpg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\screengrabcraft-editor.exe\SupportedTypes" Name=".jpeg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\ScreenGrabCraft\Editor\Capabilities\FileAssociations" Name=".jpg" Value="ScreenGrabCraft.Jpeg" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\ScreenGrabCraft\Editor\Capabilities\FileAssociations" Name=".jpeg" Value="ScreenGrabCraft.Jpeg" Type="string" />

        <ProgId Id="ScreenGrabCraft.Gif" Description="GIF Image" Icon="EditorExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\ScreenGrabCraft.Gif\shell\open\command" Value="&quot;[#EditorExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.gif\OpenWithProgids" Name="ScreenGrabCraft.Gif" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\screengrabcraft-editor.exe\SupportedTypes" Name=".gif" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\ScreenGrabCraft\Editor\Capabilities\FileAssociations" Name=".gif" Value="ScreenGrabCraft.Gif" Type="string" />

        <ProgId Id="ScreenGrabCraft.Bmp" Description="Bitmap Image" Icon="EditorExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\ScreenGrabCraft.Bmp\shell\open\command" Value="&quot;[#EditorExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.bmp\OpenWithProgids" Name="ScreenGrabCraft.Bmp" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\screengrabcraft-editor.exe\SupportedTypes" Name=".bmp" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\ScreenGrabCraft\Editor\Capabilities\FileAssociations" Name=".bmp" Value="ScreenGrabCraft.Bmp" Type="string" />

        <ProgId Id="ScreenGrabCraft.Webp" Description="WebP Image" Icon="EditorExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\ScreenGrabCraft.Webp\shell\open\command" Value="&quot;[#EditorExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.webp\OpenWithProgids" Name="ScreenGrabCraft.Webp" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\screengrabcraft-editor.exe\SupportedTypes" Name=".webp" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\ScreenGrabCraft\Editor\Capabilities\FileAssociations" Name=".webp" Value="ScreenGrabCraft.Webp" Type="string" />

        <!-- ScreenGrabCraft's own project files: the editor is their default program. -->
        <ProgId Id="ScreenGrabCraft.Project" Description="ScreenGrabCraft Project" Icon="EditorExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\ScreenGrabCraft.Project\shell\open\command" Value="&quot;[#EditorExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.sgcraft" Value="ScreenGrabCraft.Project" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.sgcraft" Name="Content Type" Value="application/x-screengrabcraft-project" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.sgcraft\OpenWithProgids" Name="ScreenGrabCraft.Project" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\screengrabcraft-editor.exe\SupportedTypes" Name=".sgcraft" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\ScreenGrabCraft\Editor\Capabilities\FileAssociations" Name=".sgcraft" Value="ScreenGrabCraft.Project" Type="string" />
      </Component>

      <Component Id="ScreenGrabCraftCli">
        <File Id="ScreenGrabCraftCliExe" Source="$(var.BinDir)\screengrabcraft-cli.exe" KeyPath="yes" />
      </Component>

      <!-- Remove Background's model (IS-Net, Apache-2.0; see assets/models/README.md), in models\
           beside the editor and the command-line program, where they look for it. -->
      <Component Id="BackgroundModel" Directory="MODELSFOLDER" Guid="F4C1D861-7EB5-42E6-8C81-3A4587B9C577">
