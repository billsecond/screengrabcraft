<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- "ScreenGrabCraft Editor.app". Template: packaging/macos/package.sh substitutes @VERSION@
     (full, e.g. 0.2.0-rc.1), @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. The capture
     service has its own: Info.plist.in. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>ScreenGrabCraft Editor</string>
  <key>CFBundleName</key>
  <string>ScreenGrabCraft Editor</string>
  <key>CFBundleExecutable</key>
  <string>ScreenGrabCraft Editor</string>
  <key>CFBundleIdentifier</key>
  <string>io.github.billsecond.screengrabcraft.editor</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>ScreenGrabCraftVersion</key>
  <string>@VERSION@</string>
  <key>ScreenGrabCraftBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>ScreenGrabCraft Editor</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.graphics-design</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the ScreenGrabCraft contributors. MIT OR Apache-2.0.</string>

  <!-- What the editor opens: pictures (offered in "Open With", never taking them over) and its
       own project files, which it owns. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Image</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.png</string>
        <string>public.jpeg</string>
        <string>com.compuserve.gif</string>
        <string>com.microsoft.bmp</string>
        <string>org.webmproject.webp</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>ScreenGrabCraft Project</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>io.github.billsecond.screengrabcraft.project</string>
      </array>
    </dict>
  </array>

  <!-- The project file type (.sgcraft, JSON), declared by the app that owns it. -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>io.github.billsecond.screengrabcraft.project</string>
      <key>UTTypeDescription</key>
      <string>ScreenGrabCraft Project</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.json</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>sgcraft</string>
        </array>
        <key>public.mime-type</key>
        <array>
          <string>application/x-screengrabcraft-project</string>
        </array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
