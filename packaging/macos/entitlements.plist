<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for both ScreenGrabCraft apps. The apps are pure Rust, load no
     unsigned code, need no JIT, and are not sandboxed (they save captures in
     Pictures/ScreenGrabCraft and open files by path, from the command line and drag-and-drop).
     Capturing the screen needs the owner's Screen Recording permission (System Settings › Privacy
     & Security), which is not an entitlement. Add exceptions here only with a reason in a
     comment. -->
<plist version="1.0">
<dict>
  <!-- Video recordings: the microphone and the camera, when the owner chooses them (macOS still
       asks the owner the first time; without these the hardened runtime refuses silently). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>
